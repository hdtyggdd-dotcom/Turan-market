diff --git a/lib/check-depth.js b/lib/check-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..c9d0864186e2c5e51193e5e7ed656a302d561cae
--- /dev/null
+++ b/lib/check-depth.js
@@ -0,0 +1,19 @@
+'use strict';
+
+// Validate without recursion, before any recursive AST walker is entered.
+// Ignore parent links, which are intentionally cyclic in the parser's AST.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  const seen = new Set();
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > 128 || seen.has(node)) {
+      throw new SyntaxError('Brace AST exceeds nesting limit or contains a cycle');
+    }
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
