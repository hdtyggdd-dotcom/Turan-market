modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
EXPO_PUBLIC_REVENUECAT_MODE = "test"
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY = "test_hhsWtHbJwwWQbERVaEHPGdDpDMG"
REVENUECAT_GOOGLE_PLAY_STORE_APP_ID = "app7418a55ec3"
REVENUECAT_PROJECT_ID = "projc1f3f985"
REVENUECAT_TEST_STORE_APP_ID = "app4e2679c32d"
